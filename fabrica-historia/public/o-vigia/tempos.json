 "historia": "o-vigia",
 "duracaoMs": 61323,
 "cenas": [
  {
   "fala": "Na minha cidade, quando o sino toca meia-noite, todo mundo tranca a porta.",
   "tomadas": [
    "sinoTorre",
    "vilaGeral"
   ],
   "som": "sino",
   "audio": "o-vigia/fala-00-db5fcb22.v115.wav",
   "inicioMs": 0,
   "falaMs": 120,
   "fimMs": 7749
  },
  {
   "fala": "É a hora que o Homem Comprido sai pra andar.",
   "tomadas": [
    "ruaNeblina",
    "compridoRosto"
   ],
   "som": "grave",
   "audio": "o-vigia/fala-01-91c627d5.v115.wav",
   "inicioMs": 7749,
   "falaMs": 7869,
   "fimMs": 12583
  },
  {
   "fala": "Todo mundo tem pavor dele. Menos eu.",
   "tomadas": [
    "vizinhoApaga",
    "meninoCalmo"
   ],
   "som": null,
   "audio": "o-vigia/fala-02-96aa8b71.v115.wav",
   "inicioMs": 12583,
   "falaMs": 12703,
   "fimMs": 18095
  },
  {
   "fala": "Toda noite ele para na frente da minha casa...",
   "tomadas": [
    "compridoFrenteCasa"
   ],
   "som": null,
   "audio": "o-vigia/fala-03-d764c8e9.v115.wav",
   "inicioMs": 18095,
   "falaMs": 18215,
   "fimMs": 22705
  },
  {
   "fala": "e fica olhando pro meu telhado.",
   "tomadas": [
    "compridoOlhaCima"
   ],
   "som": null,
   "audio": "o-vigia/fala-04-6400ade2.v115.wav",
   "inicioMs": 22705,
   "falaMs": 22825,
   "fimMs": 26473
  },
  {
   "fala": "Ontem eu subi pra descobrir o que ele tanto olha.",
   "tomadas": [
    "meninoSobe",
    "meninoTelhado"
   ],
   "som": null,
   "audio": "o-vigia/fala-05-aaace872.v115.wav",
   "inicioMs": 26473,
   "falaMs": 26593,
   "fimMs": 31431
  },
  {
   "fala": "Tinha uma coisa agarrada na chaminé.",
   "tomadas": [
    "criaturaChamine"
   ],
   "som": "grave",
   "audio": "o-vigia/fala-06-beb7b5d3.v115.wav",
   "inicioMs": 31431,
   "falaMs": 31551,
   "fimMs": 34936
  },
  {
   "fala": "Ela estava olhando direto pra minha janela.",
   "tomadas": [
    "criaturaRosto",
    "olharJanela"
   ],
   "som": null,
   "audio": "o-vigia/fala-07-41a4fd63.v115.wav",
   "inicioMs": 34936,
   "falaMs": 35056,
   "fimMs": 39559
  },
  {
   "fala": "O Homem Comprido nunca quis me pegar.",
   "tomadas": [
    "compridoVigia"
   ],
   "som": null,
   "audio": "o-vigia/fala-08-19492adc.v115.wav",
   "inicioMs": 39559,
   "falaMs": 39679,
   "fimMs": 44487
  },
  {
   "fala": "Ele passava a noite inteira vigiando ela.",
   "tomadas": [
    "planoGeral"
   ],
   "som": null,
   "audio": "o-vigia/fala-09-cb184fda.v115.wav",
   "inicioMs": 44487,
   "falaMs": 44607,
   "fimMs": 49117
  },
  {
   "fala": "Hoje o sino tocou...",
   "tomadas": [
    "sinoBalanca"
   ],
   "som": "sino",
   "audio": "o-vigia/fala-10-103ae702.v115.wav",
   "inicioMs": 49117,
   "falaMs": 49237,
   "fimMs": 52330
  },
  {
   "fala": "e ele não apareceu.",
   "tomadas": [
    "ruaVazia"
   ],
   "som": null,
   "audio": "o-vigia/fala-11-9119052a.v115.wav",
   "inicioMs": 52330,
   "falaMs": 52450,
   "fimMs": 55747
  },
  {
