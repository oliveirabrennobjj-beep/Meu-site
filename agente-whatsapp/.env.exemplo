# Copie para .env e preencha.

# Chave da API do Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (developers.facebook.com > seu app > WhatsApp > Configuração da API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Senha que você inventa e cola também no campo "Verificar token" do webhook na Meta
WHATSAPP_VERIFY_TOKEN=
# Configurações do app > Básico > Chave secreta do app (confere se as mensagens vêm da Meta)
WHATSAPP_APP_SECRET=

# Seu número PESSOAL, que recebe os avisos de orçamento, visita e chamados (só dígitos, com 55 e DDD)
WHATSAPP_DONO=

PORT=3000
